{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Mailsink": "Information"
    }
  },
  "AllowedHosts": "*",
  "Mailsink": {
    "DataDir": "./data",
    "Storage": "Sqlite",
    "BlobStorage": "File",
    "DefaultDomain": "test.local",
    "Hostname": "mailsink",
    "BindAddress": "127.0.0.1",
    "Auth": {
      "Mode": "AcceptAny",
      "RequireTls": false,
      "FailureDelay": "00:00:00.500",
      "Users": []
    },
    "Smtp": {
      "Capture": { "Enabled": true, "Port": 1025, "StartTls": "Optional", "RequireAuth": false, "SaveToSent": false },
      "Submission": { "Enabled": true, "Port": 1587, "StartTls": "Optional", "RequireAuth": true, "SaveToSent": true },
      "Smtps": { "Enabled": false, "Port": 1465, "RequireAuth": true, "SaveToSent": true },
      "MaxMessageSize": 52428800,
      "MaxRecipients": 1000,
      "AutoCreateRecipients": true,
      "PlusAddressFolders": false
    },
    "Imap": {
      "Enabled": true,
      "Port": 1143,
      "ImapsPort": 1993,
      "ImapsEnabled": true,
      "EnableRev2": false,
      "IdleTimeout": "00:29:00",
      "OutboxSubmission": false,
      "PreAuth": false
    },
    "Pop3": { "Enabled": false, "Port": 1110 },
    "Http": { "Urls": "http://127.0.0.1:8025", "BasePath": "/", "UiAuthFile": null, "CorsOrigins": [] },
    "Tls": { "CertificatePath": null, "KeyPath": null, "GenerateSelfSigned": true, "Hostnames": [] },
    "Retention": { "MaxMessages": 500, "MaxAge": "7.00:00:00", "AppliesToMailboxes": false, "Interval": "00:01:00" }
  }
}
